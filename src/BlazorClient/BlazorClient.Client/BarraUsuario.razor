@inject SesionUsuario Sesion

<div class="card mb-3">
    <div class="card-body d-flex align-items-end gap-2">
        <div>
            <label class="form-label mb-1">Id de usuario (temporal, hasta que exista el login)</label>
            <input type="number" min="1" class="form-control" @bind="Sesion.IdUsuario" />
        </div>
        <button class="btn btn-outline-secondary" @onclick="() => AlCambiar.InvokeAsync()">Cargar datos</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback AlCambiar { get; set; }
}

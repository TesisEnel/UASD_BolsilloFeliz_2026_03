@page "/presupuestos"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Presupuestos</PageTitle>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success" style="max-width:1100px;" role="alert">@mensaje</div>
}
@if (!string.IsNullOrEmpty(error) && !abierto)
{
    <div class="alert alert-danger" style="max-width:1100px;" role="alert">@error</div>
}

<div class="border bg-white d-flex flex-column w-100" style="max-width:1100px; height:70vh; border-radius:1.25rem; overflow:hidden;">
    <div class="d-flex align-items-center justify-content-between px-4 py-3 border-bottom">
        <h1 class="h4 m-0">Presupuestos</h1>
        <button type="button" class="btn btn-primary" @onclick="Nuevo" disabled="@(categoriasGasto.Count == 0)">Crear</button>
    </div>

    <div class="px-3" style="flex:1; overflow-y:auto;">
        @if (lista is null)
        {
            <p class="text-center text-muted my-4">Cargando...</p>
        }
        else if (categoriasGasto.Count == 0)
        {
            <p class="text-center text-muted my-4">Necesita al menos una categoría de gasto. Créela en <a href="categorias">Categorías</a>.</p>
        }
        else if (lista.Count == 0)
        {
            <p class="text-center text-muted my-4">Aún no hay registros.</p>
        }
        else
        {
            @foreach (var x in lista)
            {
                var gastado = Gastado(x);
                var pct = x.Monto > 0 ? (double)(gastado / x.Monto) * 100 : 0;
                var color = pct >= 100 ? "bg-danger" : pct >= 80 ? "bg-warning" : "bg-success";

                <div class="px-2 py-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div style="flex:1; min-width:0;">
                            <div class="fw-semibold text-truncate">
                                @x.Nombre
                                @if (!x.Estado)
                                {
                                    <span class="badge text-bg-secondary ms-1">Inactivo</span>
                                }
                            </div>
                            <div class="text-muted small text-truncate">
                                @NombreCategoria(x.IdCategoria), @NombreCuenta(x.IdCuenta), @x.FechaInicio.ToString("dd/MM/yyyy") - @x.FechaFin.ToString("dd/MM/yyyy")@(string.IsNullOrWhiteSpace(x.Descripcion) ? "" : ", " + x.Descripcion)
                            </div>
                        </div>
                        <div class="text-end small" style="min-width:160px;">
                            <span class="fw-semibold @(pct >= 100 ? "text-danger" : "")">@gastado.ToString("N2")</span>
                            <span class="text-muted">/ @x.Monto.ToString("N2")</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Editar(x)">Editar</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(x)">Eliminar</button>
                    </div>
                    <div class="progress mt-2" style="height:8px;" role="progressbar" aria-valuenow="@((int)Math.Min(pct, 100))" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @color" style="width:@(Math.Min(pct, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                    <div class="small text-muted mt-1">
                        @pct.ToString("0")% usado ·
                        @if (x.Monto - gastado >= 0)
                        {
                            <span>Disponible: @((x.Monto - gastado).ToString("N2"))</span>
                        }
                        else
                        {
                            <span class="text-danger">Excedido por @((gastado - x.Monto).ToString("N2"))</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (abierto)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="item" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(EsNuevo ? "Nuevo presupuesto" : "Editar presupuesto")</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger" role="alert">@error</div>
                        }
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="item.Nombre" />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label">Categoría</label>
                                <InputSelect class="form-select" @bind-Value="item.IdCategoria">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var c in categoriasGasto)
                                    {
                                        <option value="@c.IdCategoria">@c.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Cuenta (opcional)</label>
                                <InputSelect class="form-select" @bind-Value="idCuentaSel">
                                    <option value="0">Todas las cuentas</option>
                                    @foreach (var c in cuentas)
                                    {
                                        <option value="@c.IdCuenta">@c.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Monto</label>
                            <InputNumber class="form-control" @bind-Value="item.Monto" />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label">Fecha inicio</label>
                                <InputDate class="form-control" @bind-Value="item.FechaInicio" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Fecha fin</label>
                                <InputDate class="form-control" @bind-Value="item.FechaFin" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control" @bind-Value="item.Descripcion" />
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" id="chkActivo" @bind-Value="item.Estado" />
                            <label class="form-check-label" for="chkActivo">Activo</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@cargando">Guardar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private int idUsuario;
    private bool abierto;
    private bool cargando;
    private string? mensaje;
    private string? error;

    private static readonly string[] tiposGasto = { "Gasto", "Pago de deuda", "Prestamo otorgado" };

    private List<PresupuestoDto>? lista;
    private List<CuentaDto> cuentas = new();
    private List<CategoriaDto> categorias = new();
    private List<TransaccionDto> transacciones = new();
    private PresupuestoDto item = new();

    // Un presupuesto controla gastos, así que solo se ofrecen categorías de gasto (Tipo = false).
    private List<CategoriaDto> categoriasGasto => categorias.Where(c => !c.Tipo).ToList();

    private int idCuentaSel
    {
        get => item.IdCuenta ?? 0;
        set => item.IdCuenta = value == 0 ? null : value;
    }

    private bool EsNuevo => item.IdPresupuesto == 0;

    private string NombreCategoria(int id) => categorias.FirstOrDefault(c => c.IdCategoria == id)?.Nombre ?? "";
    private string NombreCuenta(int? id) => id is null ? "Todas las cuentas" : cuentas.FirstOrDefault(c => c.IdCuenta == id)?.Nombre ?? "";

    // Gasto completado dentro del período, de la misma categoría (y de la cuenta, si el presupuesto tiene una).
    private decimal Gastado(PresupuestoDto p)
    {
        var desde = p.FechaInicio.ToDateTime(TimeOnly.MinValue);
        var hasta = p.FechaFin.ToDateTime(TimeOnly.MinValue).AddDays(1);

        return transacciones
            .Where(t => t.Estado == "Completada"
                        && tiposGasto.Contains(t.Tipo)
                        && t.IdCategoria == p.IdCategoria
                        && (p.IdCuenta is null || t.IdCuenta == p.IdCuenta)
                        && t.Fecha >= desde && t.Fecha < hasta)
            .Sum(t => t.Monto);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var usuarios = await Http.GetFromJsonAsync<List<UsuarioDto>>("api/usuarios") ?? new();
            idUsuario = usuarios.Where(x => x.Estado).OrderBy(x => x.IdUsuario)
                                .Select(x => x.IdUsuario).FirstOrDefault();
            if (idUsuario == 0)
            {
                error = "No hay usuarios registrados.";
                return;
            }

            cuentas = await Http.GetFromJsonAsync<List<CuentaDto>>($"api/cuentas?idUsuario={idUsuario}") ?? new();
            categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>($"api/categorias?idUsuario={idUsuario}") ?? new();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            lista ??= new();
        }
    }

    private async Task Cargar()
    {
        lista = await Http.GetFromJsonAsync<List<PresupuestoDto>>($"api/presupuestos?idUsuario={idUsuario}") ?? new();
        transacciones = await Http.GetFromJsonAsync<List<TransaccionDto>>($"api/transacciones?idUsuario={idUsuario}") ?? new();
    }

    private void Nuevo()
    {
        item = new() { IdUsuario = idUsuario };
        mensaje = null; error = null; abierto = true;
    }

    private void Editar(PresupuestoDto x)
    {
        item = new()
        {
            IdPresupuesto = x.IdPresupuesto, IdUsuario = x.IdUsuario, IdCategoria = x.IdCategoria,
            IdCuenta = x.IdCuenta, Nombre = x.Nombre, Monto = x.Monto, FechaInicio = x.FechaInicio,
            FechaFin = x.FechaFin, Descripcion = x.Descripcion, Estado = x.Estado
        };
        mensaje = null; error = null; abierto = true;
    }

    private void Cerrar()
    {
        abierto = false;
        error = null;
    }

    private async Task Guardar()
    {
        error = null;

        if (item.FechaFin < item.FechaInicio)
        {
            error = "La fecha fin no puede ser anterior a la fecha de inicio.";
            return;
        }

        cargando = true;
        try
        {
            var nuevo = EsNuevo;
            var respuesta = nuevo
                ? await Http.PostAsJsonAsync("api/presupuestos", item)
                : await Http.PutAsJsonAsync($"api/presupuestos/{item.IdPresupuesto}", item);

            if (respuesta.IsSuccessStatusCode)
            {
                abierto = false;
                mensaje = nuevo ? "Presupuesto creado correctamente." : "Presupuesto actualizado correctamente.";
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Eliminar(PresupuestoDto x)
    {
        mensaje = null;
        error = null;

        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el presupuesto {x.Nombre}?"))
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/presupuestos/{x.IdPresupuesto}");
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Presupuesto eliminado correctamente.";
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }
}

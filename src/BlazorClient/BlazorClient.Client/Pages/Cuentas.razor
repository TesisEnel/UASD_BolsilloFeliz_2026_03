@page "/cuentas"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Cuentas</PageTitle>



@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success" style="max-width:1100px;" role="alert">@mensaje</div>
}
@if (!string.IsNullOrEmpty(error) && !abierto)
{
    <div class="alert alert-danger" style="max-width:1100px;" role="alert">@error</div>
}

<div class="border bg-white d-flex flex-column w-100" style="max-width:1100px; height:70vh; border-radius:1.25rem; overflow:hidden;">
    <div class="d-flex align-items-center justify-content-between px-4 py-3 border-bottom">
        <h1 class="h4 m-0">Cuentas</h1>
        <button type="button" class="btn btn-primary" @onclick="Nueva">Crear</button>
    </div>

    <div class="px-3" style="flex:1; overflow-y:auto;">
        @if (lista is null)
        {
            <p class="text-center text-muted my-4">Cargando...</p>
        }
        else if (lista.Count == 0)
        {
            <p class="text-center text-muted my-4">Aún no hay registros.</p>
        }
        else
        {
            @foreach (var x in lista)
            {
                <div class="d-flex align-items-center gap-3 px-2 py-3 border-bottom">
                    <div style="flex:1; min-width:0;">
                        <div class="fw-semibold text-truncate">@x.Nombre</div>
                        <div class="text-muted small text-truncate">@x.Tipo@(string.IsNullOrWhiteSpace(x.Descripcion) ? "" : ", " + x.Descripcion)</div>
                    </div>
                    <div class="text-end" style="min-width:170px;">
                        <div class="small text-muted">Saldo actual</div>
                        @if (saldos.TryGetValue(x.IdCuenta, out var saldo))
                        {
                            <div class="fw-semibold @(saldo < 0 ? "text-danger" : "text-success")">@CodigoMoneda(x.IdMoneda) @saldo.ToString("N2")</div>
                        }
                        else
                        {
                            <div class="fw-semibold text-muted">—</div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Editar(x)">Editar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(x)">Eliminar</button>
                </div>
            }
        }
    </div>
</div>

@if (abierto)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="item" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(EsNuevo ? "Nueva cuenta" : "Editar cuenta")</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger" role="alert">@error</div>
                        }
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="item.Nombre" />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label">Tipo</label>
                                <InputSelect class="form-select" @bind-Value="item.Tipo">
                                    @foreach (var t in tipos)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Moneda</label>
                                <InputSelect class="form-select" @bind-Value="item.IdMoneda">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var m in monedas)
                                    {
                                        <option value="@m.IdMoneda">@m.Codigo - @m.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Saldo de apertura</label>
                            <InputNumber class="form-control" @bind-Value="item.SaldoInicial" />
                        </div>
                        <div>
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control" @bind-Value="item.Descripcion" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@cargando">Guardar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private int idUsuario;
    private bool abierto;
    private bool cargando;
    private string? mensaje;
    private string? error;

    private static readonly string[] tipos =
        { "Efectivo", "Banco", "Ahorro", "Tarjeta de credito", "Inversion", "Otro" };

    private List<CuentaDto>? lista;
    private List<MonedaDto> monedas = new();
    private CuentaDto item = new();

    // Saldo actual por cuenta, calculado por la API (apertura + transacciones completadas + transferencias)
    private Dictionary<int, decimal> saldos = new();

    private bool EsNuevo => item.IdCuenta == 0;
    private int IdItem => item.IdCuenta;
    private static int IdDe(CuentaDto x) => x.IdCuenta;
    private static string Descripcion(CuentaDto x) => $"la cuenta {x.Nombre}";
    private string CodigoMoneda(int id) => monedas.FirstOrDefault(m => m.IdMoneda == id)?.Codigo ?? "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var usuarios = await Http.GetFromJsonAsync<List<UsuarioDto>>("api/usuarios") ?? new();
            idUsuario = usuarios.Where(x => x.Estado).OrderBy(x => x.IdUsuario)
                                .Select(x => x.IdUsuario).FirstOrDefault();
            if (idUsuario == 0)
            {
                error = "No hay usuarios registrados.";
                return;
            }

            monedas = await Http.GetFromJsonAsync<List<MonedaDto>>("api/monedas") ?? new();
            await Cargar();
        }
        catch (Exception ex)
        {
            error = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            lista ??= new();
        }
    }

    private async Task Cargar()
    {
        lista = await Http.GetFromJsonAsync<List<CuentaDto>>($"api/cuentas?idUsuario={idUsuario}") ?? new();

        var dashboard = await Http.GetFromJsonAsync<DashboardDto>($"api/dashboard?idUsuario={idUsuario}");
        saldos = dashboard?.Saldos.ToDictionary(s => s.IdCuenta, s => s.Saldo) ?? new();
    }

    private void Nueva()
    {
        item = new() { IdUsuario = idUsuario };
        mensaje = null; error = null; abierto = true;
    }

    private void Editar(CuentaDto x)
    {
        item = new()
        {
            IdCuenta = x.IdCuenta, IdUsuario = x.IdUsuario, IdMoneda = x.IdMoneda,
            Nombre = x.Nombre, Tipo = x.Tipo, SaldoInicial = x.SaldoInicial, Descripcion = x.Descripcion
        };
        mensaje = null; error = null; abierto = true;
    }

    private void Cerrar()
    {
        abierto = false;
        error = null;
    }

    private async Task Guardar()
    {
        error = null;
        cargando = true;
        try
        {
            var nuevo = EsNuevo;
            var respuesta = nuevo
                ? await Http.PostAsJsonAsync("api/cuentas", item)
                : await Http.PutAsJsonAsync($"api/cuentas/{IdItem}", item);

            if (respuesta.IsSuccessStatusCode)
            {
                abierto = false;
                mensaje = nuevo ? "Cuenta creada correctamente." : "Cuenta actualizada correctamente.";
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Eliminar(CuentaDto x)
    {
        mensaje = null;
        error = null;

        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar {Descripcion(x)}?"))
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/cuentas/{IdDe(x)}");
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Cuenta eliminada correctamente.";
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }
}
@page "/pagina_autenticacion"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Iniciar sesión</h1>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        @if (sesionActiva is not null)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
                <span>Sesión iniciada como <strong>@sesionActiva</strong>.</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CerrarSesion">Cerrar sesión</button>
            </div>
        }

        <EditForm Model="credenciales" OnValidSubmit="Ingresar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText type="email" class="form-control" @bind-Value="credenciales.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <InputText type="password" class="form-control" @bind-Value="credenciales.Password" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@cargando">
                @(cargando ? "Ingresando..." : "Iniciar sesión")
            </button>
        </EditForm>

        <p class="text-center mt-3">
            ¿No tiene cuenta? <a href="registrar-usuario">Crear usuario</a>
        </p>
    </div>
</div>

@code {
    // Solo Email y Password: es lo único que se envía a la API.
    private class Credenciales
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El email es obligatorio.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "El email no es válido.")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = "";
    }

    private Credenciales credenciales = new();
    private string? sesionActiva;
    private string? error;
    private bool cargando;

    protected override async Task OnInitializedAsync()
    {
        sesionActiva = await JS.InvokeAsync<string?>("localStorage.getItem", "nombreUsuario");
    }

    private async Task Ingresar()
    {
        error = null;
        cargando = true;

        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/usuarios/login", credenciales);

            if (respuesta.IsSuccessStatusCode)
            {
                var usuario = await respuesta.Content.ReadFromJsonAsync<UsuarioDto>();

                if (usuario is null)
                {
                    error = "Respuesta inválida de la API.";
                    return;
                }

                await JS.InvokeVoidAsync("localStorage.setItem", "idUsuario", usuario.IdUsuario.ToString());
                await JS.InvokeVoidAsync("localStorage.setItem", "nombreUsuario", $"{usuario.Nombres} {usuario.Apellidos}");

                Nav.NavigateTo("ahorros");
            }
            else
            {
                error = await LeerError(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "idUsuario");
        await JS.InvokeVoidAsync("localStorage.removeItem", "nombreUsuario");
        sesionActiva = null;
    }

    private static async Task<string> LeerError(HttpResponseMessage respuesta)
    {
        try
        {
            var e = await respuesta.Content.ReadFromJsonAsync<ErrorApiDto>();
            if (!string.IsNullOrWhiteSpace(e?.Mensaje))
                return e.Mensaje;
        }
        catch
        {
            // la respuesta no tenía el formato esperado
        }

        return $"Error {(int)respuesta.StatusCode}: {respuesta.ReasonPhrase}";
    }
}
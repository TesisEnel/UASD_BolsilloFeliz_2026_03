@page "/deudas"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Deudas</PageTitle>

<h1 class="mb-3">Deudas</h1>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (entidades.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Este usuario no tiene entidades. Cree una primero en <a href="entidades">Entidades</a>.
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@(item.IdDeuda == 0 ? "Nueva deuda" : $"Editando deuda")</h5>

        <EditForm Model="item" OnValidSubmit="GuardarItem">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Entidad (a quién se le debe)</label>
                    <InputSelect class="form-select" @bind-Value="item.IdEntidad">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var e in entidades)
                        {
                            <option value="@e.IdEntidad">@e.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="item.Nombre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Monto original</label>
                    <InputNumber class="form-control" @bind-Value="item.MontoOriginal" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha de la deuda</label>
                    <InputDate class="form-control" @bind-Value="item.FechaDeuda" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha de vencimiento (opcional)</label>
                    <InputDate class="form-control" @bind-Value="item.FechaVencimiento" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Cuota mensual (opcional)</label>
                    <InputNumber class="form-control" @bind-Value="item.CuotaMensual" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <InputSelect class="form-select" @bind-Value="item.Estado">
                        @foreach (var s in estados)
                        {
                            <option value="@s">@s</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="item.Descripcion" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" disabled="@cargando">
                    @(item.IdDeuda == 0 ? "Crear" : "Actualizar")
                </button>
                @if (item.IdDeuda != 0)
                {
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarItem">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (cargandoLista)
{
    <p><em>Cargando...</em></p>
}
else if (items.Count == 0)
{
    <p>No hay deudas registradas para este usuario.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Entidad</th>
                    <th class="text-end">Monto original</th>
                    <th class="text-end">Pagado</th>
                    <th class="text-end">Pendiente</th>
                    <th>Vence</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in items)
                {
                    <tr class="@(seleccionado?.IdDeuda == x.IdDeuda ? "table-active" : "")">
                        <td>@x.Nombre</td>
                        <td>@NombreEntidad(x.IdEntidad)</td>
                        <td class="text-end">@x.MontoOriginal.ToString("N2")</td>
                        <td class="text-end">@Acumulado(x).ToString("N2")</td>
                        <td class="text-end">@((x.MontoOriginal - Acumulado(x)).ToString("N2"))</td>
                        <td>@(x.FechaVencimiento?.ToString("dd/MM/yyyy"))</td>
                        <td><span class="badge @ClaseEstado(x.Estado)">@x.Estado</span></td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-success" @onclick="() => Seleccionar(x)">Pagos</button>
                            <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => EditarItem(x)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => EliminarItem(x)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (seleccionado is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Pagos de la deuda: @seleccionado.Nombre</h5>
            <p class="text-muted">
                Monto original @seleccionado.MontoOriginal.ToString("N2") ·
                Pagado @Acumulado(seleccionado).ToString("N2") ·
                Pendiente @((seleccionado.MontoOriginal - Acumulado(seleccionado)).ToString("N2"))
            </p>

            <EditForm Model="pago" OnValidSubmit="GuardarPago">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Monto</label>
                        <InputNumber class="form-control" @bind-Value="pago.MontoPagado" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha</label>
                        <InputDate class="form-control" @bind-Value="pago.FechaPago" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Descripción</label>
                        <InputText class="form-control" @bind-Value="pago.Descripcion" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success" disabled="@cargando">
                        @(pago.IdDetalleDeuda == 0 ? "Registrar pago" : "Actualizar")
                    </button>
                    @if (pago.IdDetalleDeuda != 0)
                    {
                        <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarPago">Cancelar</button>
                    }
                    <button type="button" class="btn btn-link ms-2" @onclick="CerrarPagos">Cerrar</button>
                </div>
                <small class="text-muted d-block mt-2">
                    Al registrar se crea automáticamente una transacción de tipo "Pago de deuda".
                </small>
            </EditForm>

            @if (PagosDe(seleccionado).Count == 0)
            {
                <p class="mt-3">Todavía no hay pagos registrados.</p>
            }
            else
            {
                <table class="table table-sm align-middle mt-3">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th class="text-end">Monto</th>
                            <th>Descripción</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in PagosDe(seleccionado))
                        {
                            <tr>
                                <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@p.MontoPagado.ToString("N2")</td>
                                <td>@p.Descripcion</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarPago(p)">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => EliminarPago(p)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private static readonly string[] estados = { "Activa", "Vencida", "Pagada", "Cancelada" };

    private List<DeudaDto> items = new();
        private static string ClaseEstado(string estado) => estado switch
    {
        "Activa" => "bg-primary",
        "Vencida" => "bg-danger",
        "Pagada" => "bg-success",
        _ => "bg-secondary"
    };
    private List<EntidadDto> entidades = new();
    private List<DetallesDeudaDto> pagos = new();

    private DeudaDto item = NuevoItem();
    private DeudaDto? seleccionado;
    private DetallesDeudaDto pago = NuevoPago();

    private string? mensaje;
    private string? error;
    private bool cargando;
    private bool cargandoLista = true;

    private static DeudaDto NuevoItem() => new();

    private static DetallesDeudaDto NuevoPago() => new();

    private int idUsuario;

    protected override async Task OnInitializedAsync()
    {
        await CargarTodo();
    }

    private async Task CargarTodo()
    {
        cargandoLista = true;
        try
        {
            var usuarios = await Http.GetFromJsonAsync<List<UsuarioDto>>("api/usuarios") ?? new();
            idUsuario = usuarios.Where(x => x.Estado).OrderBy(x => x.IdUsuario)
                                .Select(x => x.IdUsuario).FirstOrDefault();

            if (idUsuario == 0)
            {
                error = "No hay usuarios registrados. Cree uno primero en Registrar usuario.";
                return;
            }

            entidades = await Http.GetFromJsonAsync<List<EntidadDto>>($"api/entidades?idUsuario={idUsuario}") ?? new();
            items = await Http.GetFromJsonAsync<List<DeudaDto>>($"api/deudas?idUsuario={idUsuario}") ?? new();
            pagos = await Http.GetFromJsonAsync<List<DetallesDeudaDto>>($"api/detallesdeuda?idUsuario={idUsuario}") ?? new();

            if (seleccionado is not null)
                seleccionado = items.FirstOrDefault(x => x.IdDeuda == seleccionado.IdDeuda);
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        finally
        {
            cargandoLista = false;
        }
    }

    private string NombreEntidad(int id) =>
        entidades.FirstOrDefault(e => e.IdEntidad == id)?.Nombre ?? $"#{id}";

    private decimal Acumulado(DeudaDto x) =>
        pagos.Where(p => p.IdDeuda == x.IdDeuda).Sum(p => p.MontoPagado);

    private List<DetallesDeudaDto> PagosDe(DeudaDto x) =>
        pagos.Where(p => p.IdDeuda == x.IdDeuda).OrderByDescending(p => p.FechaPago).ToList();

    private void LimpiarMensajes()
    {
        mensaje = null;
        error = null;
    }

    // ---------- Deudas ----------
    private async Task GuardarItem()
    {
        LimpiarMensajes();

        if (item.IdEntidad == 0)
        {
            error = "Seleccione una entidad.";
            return;
        }
        if (item.MontoOriginal <= 0)
        {
            error = "El monto original debe ser mayor que cero.";
            return;
        }
        if (item.FechaVencimiento.HasValue && item.FechaVencimiento.Value < item.FechaDeuda)
        {
            error = "La fecha de vencimiento no puede ser anterior a la fecha de inicio.";
            return;
        }
        if (item.CuotaMensual.HasValue && item.CuotaMensual.Value <= 0)
        {
            error = "La cuota mensual debe ser mayor que cero.";
            return;
        }

        item.IdUsuario = idUsuario;
        cargando = true;

        try
        {
            var esNuevo = item.IdDeuda == 0;

            var respuesta = esNuevo
                ? await Http.PostAsJsonAsync("api/deudas", item)
                : await Http.PutAsJsonAsync($"api/deudas/{item.IdDeuda}", item);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = esNuevo ? "Deuda creada correctamente." : "Deuda actualizada correctamente.";
                item = NuevoItem();
                await CargarTodo();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void EditarItem(DeudaDto x)
    {
        LimpiarMensajes();
        item = new DeudaDto
        {
            IdDeuda = x.IdDeuda,
            IdUsuario = x.IdUsuario,
            IdEntidad = x.IdEntidad,
            IdTransaccionDesembolso = x.IdTransaccionDesembolso,
            Nombre = x.Nombre,
            MontoOriginal = x.MontoOriginal,
            FechaDeuda = x.FechaDeuda,
            FechaVencimiento = x.FechaVencimiento,
            CuotaMensual = x.CuotaMensual,
            Estado = x.Estado,
            Descripcion = x.Descripcion
        };
    }

    private void CancelarItem()
    {
        LimpiarMensajes();
        item = NuevoItem();
    }

    private async Task EliminarItem(DeudaDto x)
    {
        LimpiarMensajes();

        if (pagos.Any(p => p.IdDeuda == x.IdDeuda))
        {
            error = "Elimine primero los pagos de esta deuda.";
            return;
        }

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la deuda {x.Nombre}?");
        if (!confirmado)
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/deudas/{x.IdDeuda}");

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Deuda eliminada correctamente.";
                if (seleccionado?.IdDeuda == x.IdDeuda)
                    seleccionado = null;
                await CargarTodo();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
    }

    // ---------- Pagos de la deuda ----------
    private void Seleccionar(DeudaDto x)
    {
        LimpiarMensajes();
        seleccionado = x;
        pago = NuevoPago();
    }

    private void CerrarPagos()
    {
        seleccionado = null;
        pago = NuevoPago();
    }

    private async Task GuardarPago()
    {
        LimpiarMensajes();

        if (seleccionado is null)
            return;

        if (pago.MontoPagado <= 0)
        {
            error = "El monto debe ser mayor que cero.";
            return;
        }

        var esNuevo = pago.IdDetalleDeuda == 0;

        var otros = pagos
            .Where(p => p.IdDeuda == seleccionado.IdDeuda && p.IdDetalleDeuda != pago.IdDetalleDeuda)
            .Sum(p => p.MontoPagado);

        if (otros + pago.MontoPagado > seleccionado.MontoOriginal)
        {
            error = $"El monto excede lo pendiente ({(seleccionado.MontoOriginal - otros):N2}).";
            return;
        }

        cargando = true;

        try
        {
            pago.IdUsuario = idUsuario;
            pago.IdDeuda = seleccionado.IdDeuda;

            if (esNuevo)
            {
                var idTransaccion = await CrearTransaccionAsync();
                if (idTransaccion is null)
                    return; // el mensaje de error ya quedó en 'error'

                pago.IdTransaccion = idTransaccion.Value;
            }

            var respuesta = esNuevo
                ? await Http.PostAsJsonAsync("api/detallesdeuda", pago)
                : await Http.PutAsJsonAsync($"api/detallesdeuda/{pago.IdDetalleDeuda}", pago);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = esNuevo ? "Pago registrado correctamente." : "Pago actualizado correctamente.";
                pago = NuevoPago();
                await CargarTodo();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    // Cada registro de detalle exige una transacción propia (y única).
    // Se crea una transacción y luego se busca la más reciente de ese tipo que aún no esté usada.
    private async Task<int?> CrearTransaccionAsync()
    {
        var nombre = $"Pago de deuda: {seleccionado!.Nombre}";
        if (nombre.Length > 120)
            nombre = nombre[..120];

        var transaccion = new TransaccionDto
        {
            IdUsuario = idUsuario,
            Nombre = nombre,
            Monto = pago.MontoPagado,
            Tipo = "Pago de deuda",
            Fecha = pago.FechaPago,
            Estado = "Completada"
        };

        var respuesta = await Http.PostAsJsonAsync("api/transacciones", transaccion);
        if (!respuesta.IsSuccessStatusCode)
        {
            error = "No se pudo crear la transacción: " + await ApiErrores.LeerAsync(respuesta);
            return null;
        }

        var usadas = pagos.Select(p => p.IdTransaccion).ToHashSet();
        var transacciones = await Http.GetFromJsonAsync<List<TransaccionDto>>(
            $"api/transacciones?idUsuario={idUsuario}") ?? new();

        var libre = transacciones
            .Where(t => t.Tipo == "Pago de deuda" && !usadas.Contains(t.IdTransaccion))
            .OrderByDescending(t => t.IdTransaccion)
            .FirstOrDefault();

        if (libre is null)
        {
            error = "No se pudo localizar la transacción recién creada.";
            return null;
        }

        return libre.IdTransaccion;
    }

    private void EditarPago(DetallesDeudaDto p)
    {
        LimpiarMensajes();
        pago = new DetallesDeudaDto
        {
            IdDetalleDeuda = p.IdDetalleDeuda,
            IdUsuario = p.IdUsuario,
            IdDeuda = p.IdDeuda,
            IdTransaccion = p.IdTransaccion,
            MontoPagado = p.MontoPagado,
            FechaPago = p.FechaPago,
            Descripcion = p.Descripcion
        };
    }

    private void CancelarPago()
    {
        LimpiarMensajes();
        pago = NuevoPago();
    }

    private async Task EliminarPago(DetallesDeudaDto p)
    {
        LimpiarMensajes();

        var confirmado = await JS.InvokeAsync<bool>("confirm",
            "¿Eliminar este pago de " + p.MontoPagado.ToString("N2") + "? La transacción asociada se conserva en Transacciones.");
        if (!confirmado)
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/detallesdeuda/{p.IdDetalleDeuda}");

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Pago eliminado correctamente.";
                await CargarTodo();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
    }
}
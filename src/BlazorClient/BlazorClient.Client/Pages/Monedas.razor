@page "/monedas"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Monedas</PageTitle>

<h1 class="mb-3">Monedas</h1>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@(moneda.IdMoneda == 0 ? "Nueva moneda" : "Editando moneda")</h5>

        <EditForm Model="moneda" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Código</label>
                    <InputText class="form-control" @bind-Value="moneda.Codigo" placeholder="DOP" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="moneda.Nombre" placeholder="Peso dominicano" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Símbolo</label>
                    <InputText class="form-control" @bind-Value="moneda.Simbolo" placeholder="RD$" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="activa" @bind-Value="moneda.Activa" />
                        <label class="form-check-label" for="activa">Activa</label>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" disabled="@cargando">
                    @(moneda.IdMoneda == 0 ? "Crear" : "Actualizar")
                </button>
                @if (moneda.IdMoneda != 0)
                {
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (monedas is null)
{
    <p><em>Cargando...</em></p>
}
else if (monedas.Count == 0)
{
    <p>No hay monedas registradas.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                
                <th>Código</th>
                <th>Nombre</th>
                <th>Símbolo</th>
                <th>Activa</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in monedas)
            {
                <tr>
                    
                    <td>@m.Codigo</td>
                    <td>@m.Nombre</td>
                    <td>@m.Simbolo</td>
                    <td>@(m.Activa ? "Sí" : "No")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(m)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Eliminar(m)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<MonedaDto>? monedas;
    private MonedaDto moneda = new();
    private string? mensaje;
    private string? error;
    private bool cargando;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            monedas = await Http.GetFromJsonAsync<List<MonedaDto>>("api/monedas") ?? new();
        }
        catch (HttpRequestException)
        {
            monedas = new();
            error = "No se pudo conectar con la API.";
        }
    }

    private async Task Guardar()
    {
        mensaje = null;
        error = null;
        cargando = true;

        try
        {
            var esNueva = moneda.IdMoneda == 0;

            var respuesta = esNueva
                ? await Http.PostAsJsonAsync("api/monedas", moneda)
                : await Http.PutAsJsonAsync($"api/monedas/{moneda.IdMoneda}", moneda);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = esNueva ? "Moneda creada correctamente." : "Moneda actualizada correctamente.";
                moneda = new();
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void Editar(MonedaDto m)
    {
        mensaje = null;
        error = null;
        moneda = new MonedaDto
        {
            IdMoneda = m.IdMoneda,
            Codigo = m.Codigo,
            Nombre = m.Nombre,
            Simbolo = m.Simbolo,
            Activa = m.Activa
        };
    }

    private void Cancelar()
    {
        mensaje = null;
        error = null;
        moneda = new();
    }

    private async Task Eliminar(MonedaDto m)
    {
        mensaje = null;
        error = null;

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la moneda {m.Codigo}?");
        if (!confirmado)
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/monedas/{m.IdMoneda}");

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Moneda eliminada correctamente.";
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
    }
}

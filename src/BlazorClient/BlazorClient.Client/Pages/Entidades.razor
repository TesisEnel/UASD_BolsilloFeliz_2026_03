@page "/entidades"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Entidades</PageTitle>

<h1 class="mb-3">Entidades</h1>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@(entidad.IdEntidad == 0 ? "Nueva entidad" : $"Editando entidad")</h5>

        <EditForm Model="entidad" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="entidad.Nombre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <InputSelect class="form-select" @bind-Value="entidad.TipoEntidad">
                        @foreach (var tipo in tipos)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Identificación</label>
                    <InputText class="form-control" @bind-Value="entidad.Identificacion" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="entidad.Telefono" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="entidad.Email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Dirección</label>
                    <InputText class="form-control" @bind-Value="entidad.Direccion" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" disabled="@cargando">
                    @(entidad.IdEntidad == 0 ? "Crear" : "Actualizar")
                </button>
                @if (entidad.IdEntidad != 0)
                {
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (entidades is null)
{
    <p><em>Cargando...</em></p>
}
else if (entidades.Count == 0)
{
    <p>No hay entidades para este usuario.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
               
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Identificación</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in entidades)
            {
                <tr>
                    
                    <td>@e.Nombre</td>
                    <td>@e.TipoEntidad</td>
                    <td>@e.Identificacion</td>
                    <td>@e.Telefono</td>
                    <td>@e.Email</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(e)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Eliminar(e)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private static readonly string[] tipos = { "Persona", "Banco", "Empresa", "Cooperativa", "Otro" };

    private List<EntidadDto>? entidades;
    private EntidadDto entidad = new();
    private int idUsuario;
    private string? mensaje;
    private string? error;
    private bool cargando;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            var usuarios = await Http.GetFromJsonAsync<List<UsuarioDto>>("api/usuarios") ?? new();
            idUsuario = usuarios.Where(x => x.Estado).OrderBy(x => x.IdUsuario)
                                .Select(x => x.IdUsuario).FirstOrDefault();

            if (idUsuario == 0)
            {
                entidades = new();
                error = "No hay usuarios registrados. Cree uno primero en Registrar usuario.";
                return;
            }

            entidades = await Http.GetFromJsonAsync<List<EntidadDto>>($"api/entidades?idUsuario={idUsuario}") ?? new();
        }
        catch (HttpRequestException)
        {
            entidades = new();
            error = "No se pudo conectar con la API.";
        }
    }

    private async Task Guardar()
    {
        mensaje = null;
        error = null;
        cargando = true;

        try
        {
            var esNueva = entidad.IdEntidad == 0;
            entidad.IdUsuario = idUsuario;

            var respuesta = esNueva
                ? await Http.PostAsJsonAsync("api/entidades", entidad)
                : await Http.PutAsJsonAsync($"api/entidades/{entidad.IdEntidad}", entidad);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = esNueva ? "Entidad creada correctamente." : "Entidad actualizada correctamente.";
                entidad = new();
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void Editar(EntidadDto e)
    {
        mensaje = null;
        error = null;
        entidad = new EntidadDto
        {
            IdEntidad = e.IdEntidad,
            IdUsuario = e.IdUsuario,
            Nombre = e.Nombre,
            TipoEntidad = e.TipoEntidad,
            Identificacion = e.Identificacion,
            Telefono = e.Telefono,
            Email = e.Email,
            Direccion = e.Direccion
        };
    }

    private void Cancelar()
    {
        mensaje = null;
        error = null;
        entidad = new();
    }

    private async Task Eliminar(EntidadDto e)
    {
        mensaje = null;
        error = null;

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la entidad {e.Nombre}?");
        if (!confirmado)
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/entidades/{e.IdEntidad}");

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Entidad eliminada correctamente.";
                await Cargar();
            }
            else
            {
                error = await ApiErrores.LeerAsync(respuesta);
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
    }
}